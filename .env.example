# Gemini — character cards, storyboards, and the vision QA critics
GEMINI_API_KEY=

# Replicate — Seedance video generation and Whisper transcription
REPLICATE_API_TOKEN=

# Where artifacts are written. In Docker this is the mounted volume.
# DATA_ROOT=/data

# Auto-repair bounds. Cheap image stages can iterate; paid video should not.
# MAX_ATTEMPTS_IMAGE=3
# MAX_ATTEMPTS_VIDEO=2
# PROJECT_BUDGET_USD=25

# Cloudflare R2 — where finished deliverables go, so the container volume stays a
# working area rather than a growing library. Leave these blank and everything is
# kept locally instead; nothing else changes, including the links in the interface.
# The token needs object read/write on this one bucket and nothing more.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ffmpeg thread cap. Two keeps peak memory at ~240 MB, which fits a 1 GB container.
# Raise it if the container has more headroom; see lib/media/ffmpeg.ts.
# FFMPEG_THREADS=2
